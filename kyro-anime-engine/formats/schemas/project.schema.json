{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project.schema.json",
  "title": "KAE Project",
  "description": "Root document. Single JSON file shared by browser editor and Python exporter. Cross-reference checks (exposure.drawing exists, unique ids) belong in validation_service.",
  "type": "object",
  "required": [
    "format",
    "version",
    "id",
    "name",
    "settings",
    "drawings",
    "scenes"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "kae"
    },
    "version": {
      "enum": [
        1,
        2
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "created": {
      "type": "string"
    },
    "modified": {
      "type": "string"
    },
    "settings": {
      "type": "object",
      "required": [
        "width",
        "height",
        "fps",
        "duration_frames"
      ],
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 16,
          "maximum": 8192
        },
        "height": {
          "type": "integer",
          "minimum": 16,
          "maximum": 8192
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        },
        "duration_frames": {
          "type": "integer",
          "minimum": 1
        },
        "background": {
          "$ref": "drawing.schema.json#/$defs/color"
        }
      }
    },
    "palette": {
      "type": "array",
      "items": {
        "$ref": "drawing.schema.json#/$defs/color"
      }
    },
    "styles": {
      "type": "array",
      "items": {
        "$ref": "style.schema.json"
      }
    },
    "drawings": {
      "type": "object",
      "additionalProperties": {
        "$ref": "drawing.schema.json"
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "character.schema.json"
          },
          {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "not": {
              "required": [
                "format"
              ]
            },
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "name": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "effects.schema.json"
      }
    },
    "rigs": {
      "type": "array",
      "items": {
        "$ref": "rig.schema.json"
      }
    },
    "preview_range": {
      "type": "object",
      "description": "Optional inclusive frame range used by timeline playback preview.",
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "markers": {
      "type": "array",
      "description": "Named frame markers for animation beats and shot navigation.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "frame",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "frame": {
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        }
      }
    },
    "audio": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "filename",
          "mime_type",
          "start_frame",
          "offset_seconds",
          "volume"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "filename": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}\\.(aac|m4a|mp3|ogg|wav|webm)$"
          },
          "mime_type": {
            "enum": [
              "audio/aac",
              "audio/mp4",
              "audio/mpeg",
              "audio/ogg",
              "audio/wav",
              "audio/webm"
            ]
          },
          "url": {
            "type": "string"
          },
          "start_frame": {
            "type": "integer",
            "minimum": 0
          },
          "offset_seconds": {
            "type": "number",
            "minimum": 0
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "duration_frames": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "scene.schema.json"
      }
    },
    "node_graphs": {
      "type": "array",
      "description": "Saved procedural geometry node graphs.",
      "items": {
        "$ref": "node_graph.schema.json"
      }
    },
    "compositor_graph": {
      "type": "object",
      "description": "Saved ordered compositor node graph evaluated after scene effects.",
      "required": ["nodes", "links"],
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": ["id", "type"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
              "type": { "enum": ["render_layers", "color_correct", "levels", "vignette", "alpha_over", "z_depth", "output"] },
              "enabled": { "type": "boolean", "default": true },
              "params": {
                "type": "object",
                "additionalProperties": { "type": ["number", "string", "boolean"] }
              }
            }
          }
        },
        "links": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "additionalProperties": false,
            "properties": {
              "from": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
              "to": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" }
            }
          }
        }
      }
    },
    "editor_settings": {
      "type": "object",
      "description": "Editor-only workspace preferences persisted with the project; excluded from rendered artwork.",
      "additionalProperties": true,
      "properties": {
        "guides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "grid": {
              "type": "boolean"
            },
            "center": {
              "type": "boolean"
            },
            "thirds": {
              "type": "boolean"
            },
            "head": {
              "type": "boolean"
            },
            "body": {
              "type": "boolean"
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "spacing": {
              "type": "number",
              "minimum": 8,
              "maximum": 256
            },
            "centered": {
              "type": "boolean"
            },
            "eyes": {
              "type": "boolean"
            },
            "nose": {
              "type": "boolean"
            },
            "mouth": {
              "type": "boolean"
            },
            "ears": {
              "type": "boolean"
            },
            "hairline": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
