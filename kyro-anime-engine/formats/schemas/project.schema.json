{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project.schema.json",
  "title": "KAE Project",
  "description": "Root document. Single JSON file shared by browser editor and Python exporter. Cross-reference checks (exposure.drawing exists, unique ids) belong in validation_service.",
  "type": "object",
  "required": ["format", "version", "id", "name", "settings", "drawings", "scenes"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "kae" },
    "version": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "name": { "type": "string", "minLength": 1 },
    "created": { "type": "string" },
    "modified": { "type": "string" },
    "settings": {
      "type": "object",
      "required": ["width", "height", "fps", "duration_frames"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 16, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 16, "maximum": 8192 },
        "fps": { "type": "number", "exclusiveMinimum": 0, "maximum": 120 },
        "duration_frames": { "type": "integer", "minimum": 1 },
        "background": { "$ref": "drawing.schema.json#/$defs/color" }
      }
    },
    "palette": { "type": "array", "items": { "$ref": "drawing.schema.json#/$defs/color" } },
    "drawings": {
      "type": "object",
      "additionalProperties": { "$ref": "drawing.schema.json" }
    },
    "characters": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "character.schema.json" },
          {
            "type": "object",
            "required": ["id", "name"],
            "not": { "required": ["format"] },
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
              "name": { "type": "string" }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "scene_id", "type"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
          "scene_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
          "type": { "enum": ["lightning", "particles", "speed_lines", "camera_shake"] },
          "enabled": { "type": "boolean", "default": true },
          "start_frame": { "type": "integer", "minimum": 0 },
          "end_frame": { "type": "integer", "minimum": 0 },
          "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
          "count": { "type": "integer", "minimum": 1, "maximum": 200 },
          "speed": { "type": "number", "minimum": 0, "maximum": 20 },
          "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
        }
      }
    },
    "rigs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "character_id", "bones"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
          "name": { "type": "string", "minLength": 1 },
          "character_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
          "bones": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "character_part_id", "pivot"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
                "name": { "type": "string", "minLength": 1 },
                "parent_id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]{1,64}$" },
                "character_part_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
                "rotation": { "type": "number", "minimum": -3600, "maximum": 3600, "default": 0 },
                "pivot": {
                  "type": "object", "required": ["x", "y"], "additionalProperties": false,
                  "properties": {
                    "x": { "type": "number", "minimum": -8192, "maximum": 8192 },
                    "y": { "type": "number", "minimum": -8192, "maximum": 8192 }
                  }
                },
                "tracks": {
                  "type": "object", "additionalProperties": false,
                  "properties": {
                    "rotation": { "$ref": "animation.schema.json#/$defs/track" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "audio": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "filename", "mime_type", "start_frame", "offset_seconds", "volume"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
          "name": { "type": "string", "minLength": 1 },
          "filename": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}\\.(aac|m4a|mp3|ogg|wav|webm)$" },
          "mime_type": { "enum": ["audio/aac", "audio/mp4", "audio/mpeg", "audio/ogg", "audio/wav", "audio/webm"] },
          "url": { "type": "string" },
          "start_frame": { "type": "integer", "minimum": 0 },
          "offset_seconds": { "type": "number", "minimum": 0 },
          "volume": { "type": "number", "minimum": 0, "maximum": 1 },
          "duration_frames": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "scenes": { "type": "array", "minItems": 1, "items": { "$ref": "scene.schema.json" } }
  }
}
