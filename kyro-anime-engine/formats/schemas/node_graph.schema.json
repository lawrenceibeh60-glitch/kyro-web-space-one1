{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "node_graph.schema.json",
  "title": "KAE Geometry Node Graph",
  "type": "object",
  "required": [
    "id",
    "name",
    "nodes",
    "links"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "nodes": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "x",
          "y",
          "params"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "type": {
            "enum": [
              "circle",
              "rectangle",
              "ellipse",
              "line",
              "bezier",
              "subdivide",
              "smooth",
              "reverse",
              "transform",
              "join",
              "output",
              "array",
              "mirror",
              "polygon",
              "grid",
              "resample",
              "translate",
              "noise",
              "bounds"
            ]
          },
          "x": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          },
          "y": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "string",
                "boolean"
              ]
            }
          }
        }
      }
    },
    "links": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "input": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16
          }
        }
      }
    }
  }
}
