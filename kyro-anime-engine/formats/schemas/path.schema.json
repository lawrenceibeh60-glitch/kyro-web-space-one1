{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "path.schema.json",
  "title": "Path",
  "description": "A path begins with one move command followed by drawing or close commands.",
  "$defs": {
    "move": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "const": "M" },
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false
    },
    "segment": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "const": "L" },
            { "type": "number" },
            { "type": "number" }
          ],
          "items": false
        },
        {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            { "const": "Q" },
            { "type": "number" },
            { "type": "number" },
            { "type": "number" },
            { "type": "number" }
          ],
          "items": false
        },
        {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "prefixItems": [
            { "const": "C" },
            { "type": "number" },
            { "type": "number" },
            { "type": "number" },
            { "type": "number" },
            { "type": "number" },
            { "type": "number" }
          ],
          "items": false
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [{ "const": "Z" }],
          "items": false
        }
      ]
    },
    "path": {
      "type": "array",
      "minItems": 2,
      "prefixItems": [
        { "$ref": "#/$defs/move" },
        { "$ref": "#/$defs/segment" }
      ],
      "items": { "$ref": "#/$defs/segment" }
    }
  }
}
