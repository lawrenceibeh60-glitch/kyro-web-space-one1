{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "character.schema.json",
  "title": "KAE Character",
  "description": "Stable, vector-part character source that imports as independently animatable layers.",
  "type": "object",
  "required": ["format", "version", "id", "name", "parts"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "kae-character" },
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "name": { "type": "string", "minLength": 1 },
    "scene_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$", "description": "Optional scene for the imported character; omitted updates the existing placement." },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "strokes"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
          "name": { "type": "string", "minLength": 1 },
          "strokes": {
            "type": "array",
            "items": { "$ref": "drawing.schema.json#/$defs/stroke" }
          },
          "transform": { "$ref": "scene.schema.json#/$defs/transform" },
          "tracks": { "$ref": "animation.schema.json#/properties/tracks" },
          "depth": { "type": "number", "minimum": 0, "maximum": 2 }
        }
      }
    }
  }
}
