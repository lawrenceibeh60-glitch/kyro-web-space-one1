{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "effects.schema.json",
  "title": "KAE Scene Effect",
  "description": "A deterministic, scene-scoped effect evaluated for a frame range.",
  "type": "object",
  "required": ["id", "scene_id", "type"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "scene_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "type": { "enum": ["lightning", "particles", "speed_lines", "camera_shake", "glow", "impact_flash", "soft_shadow", "depth_of_field", "layer_mask", "facial_animation"] },
    "enabled": { "type": "boolean", "default": true },
    "start_frame": { "type": "integer", "minimum": 0 },
    "end_frame": { "type": "integer", "minimum": 0 },
    "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
    "count": { "type": "integer", "minimum": 1, "maximum": 200 },
    "speed": { "type": "number", "minimum": 0, "maximum": 20 },
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "focus_depth": { "type": "number", "minimum": 0, "maximum": 1 },
    "range": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "target_layer_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "mask_layer_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "blink_interval": { "type": "integer", "minimum": 8, "maximum": 240 },
    "mouth_cycle": { "type": "integer", "minimum": 4, "maximum": 120 },
    "mouth_keys": {
      "type": "array",
      "description": "Optional manually keyed mouth poses for frame-accurate dialogue timing.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["frame", "shape"],
        "properties": {
          "frame": { "type": "integer", "minimum": 0 },
          "shape": { "enum": ["neutral", "smile", "open"] }
        }
      }
    }
  }
}
