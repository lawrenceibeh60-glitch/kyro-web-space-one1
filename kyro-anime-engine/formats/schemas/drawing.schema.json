{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drawing.schema.json",
  "title": "Drawing",
  "description": "One vector drawing (a cel). Points and path-command coordinates are layer-local.",
  "type": "object",
  "required": ["id", "strokes"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string" },
    "strokes": { "type": "array", "items": { "$ref": "#/$defs/stroke" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$" },
    "point": {
      "type": "array", "minItems": 2, "maxItems": 3,
      "items": { "type": "number" }
    },
    "stroke": {
      "type": "object",
      "required": ["id"],
      "oneOf": [
        { "required": ["points"], "not": { "required": ["commands"] } },
        { "required": ["commands"], "not": { "required": ["points"] } }
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "tool": { "enum": ["brush", "pen", "eraser"], "default": "brush" },
        "color": { "$ref": "#/$defs/color" },
        "width": { "type": "number", "exclusiveMinimum": 0, "default": 4 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 },
        "closed": { "type": "boolean", "default": false },
        "fill": { "oneOf": [{ "$ref": "#/$defs/color" }, { "type": "null" }] },
        "fill_rule": { "enum": ["nonzero", "evenodd"], "default": "nonzero" },
        "line_cap": { "enum": ["butt", "round", "square"], "default": "round" },
        "line_join": { "enum": ["bevel", "round", "miter"], "default": "round" },
        "smoothing": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
        "points": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/point" } },
        "commands": { "$ref": "path.schema.json#/$defs/path" }
      }
    }
  }
}
